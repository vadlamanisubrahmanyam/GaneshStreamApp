# Copy this file to .env and fill in your own values. Never commit .env.

# Google AI Studio: https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=

# Mastodon: Settings -> Development -> New Application on your instance
# (default instance below is mastodon.social; change if you use another)
MASTODON_ACCESS_TOKEN=
MASTODON_API_BASE_URL=https://mastodon.social

# Bluesky: create an App Password in the Bluesky app under
# Settings -> App Passwords (never use your main account password here)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
# NOTE: Reddit closed self-service app creation in Nov 2025 (Responsible
# Builder Policy) — new credentials are rarely obtainable. Fill these in
# only if you already have an approved app, or if that policy changes.
REDDIT_ID=
REDDIT_SECRET=
REDDIT_USER_AGENT=GaneshStreamAI/1.0

# Reserved for future connectors (not used yet)
